# --- Required API keys ---
MISTRAL_API_KEY=""
MISTRAL_API_KEY_EJ=""
MISTRAL_AUTONOMOUS_API_KEY=""
TRAVILY_API_KEY=""

# Optional email / Gmail settings used by the frontend
RESEND_API_KEY=""
SENDER_EMAIL_ID=""
RECEIVER_EMAIL_ID="your-address@example.com"
GMAIL_CREDENTIALS_PATH="frontend/credentials.json"
GMAIL_TOKEN_PATH="frontend/token.json"

# --- App runtime settings ---
FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT="8080"
RENDER_HOST="http://127.0.0.1/"
RENDER_PROT="8080"

# --- Logging ---
LOG_FOLDER="logs"
LOG_FILE_NAME="logs/app.log"
LOG_FORMAT="%(asctime)s | %(levelname)s | %(name)s | %(funcName)s | %(message)s"
